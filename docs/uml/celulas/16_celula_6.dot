  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>datetime<BR/>gptcast<BR/>numpy<BR/>os<BR/>pandas<BR/>skimage<BR/>time<BR/>torch<BR/>typing>];
