digraph "11" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 11</B> — 144 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 11</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ FSS_THRESHOLDS</TD></TR><TR><TD ALIGN="LEFT">+ FSS_WINDOWS_PX</TD></TR><TR><TD ALIGN="LEFT">+ NYQUIST_NATIVE_KM</TD></TR><TR><TD ALIGN="LEFT">+ RES_GRID_KM</TD></TR><TR><TD ALIGN="LEFT">+ TOKEN_KM</TD></TR><TR><TD ALIGN="LEFT">+ axes</TD></TR><TR><TD ALIGN="LEFT">+ color</TD></TR><TR><TD ALIGN="LEFT">+ cols</TD></TR><TR><TD ALIGN="LEFT">+ data_str</TD></TR><TR><TD ALIGN="LEFT">+ df_fss</TD></TR><TR><TD ALIGN="LEFT">+ fig</TD></TR><TR><TD ALIGN="LEFT">+ fss_csv_path</TD></TR><TR><TD ALIGN="LEFT">+ fss_fig_path</TD></TR><TR><TD ALIGN="LEFT">+ fss_models</TD></TR><TR><TD ALIGN="LEFT"><I>+ 11 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ compute_fss_2d(obs_2d, pred_2d, thr_mmh, window_px)</TD></TR><TR><TD ALIGN="LEFT">- _useful(obs_2d, thr)</TD></TR><TR><TD ALIGN="LEFT">- _min_scale(values, useful)</TD></TR><TR><TD ALIGN="LEFT">+ fss_over_set(obs_seqs, preds, thr)</TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>datetime<BR/>matplotlib<BR/>numpy<BR/>os<BR/>pandas<BR/>scipy>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>ENV_LABEL<BR/>ENV_TAG<BR/>FORECAST_STEPS<BR/>GRID_SIZE<BR/>RESULTS_ENV_DIR<BR/>RES_KM<BR/>SERIES_CACHE_DIR<BR/>dt<BR/>forecast8_rain<BR/>ground_truth_rain>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
}
