digraph "2" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 2</B> — 426 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 2</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ ETL_VERSION</TD></TR><TR><TD ALIGN="LEFT">+ SLOT_MIN</TD></TR><TR><TD ALIGN="LEFT">+ gpm</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  cls_IMERGExtractorAdaptee [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2FD"><TR><TD><FONT POINT-SIZE="9">«classe»</FONT><BR/><B>IMERGExtractorAdaptee</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ cache_dir</TD></TR><TR><TD ALIGN="LEFT">+ center_lat</TD></TR><TR><TD ALIGN="LEFT">+ center_lon</TD></TR><TR><TD ALIGN="LEFT">+ env_label</TD></TR><TR><TD ALIGN="LEFT">+ env_log_csv_path</TD></TR><TR><TD ALIGN="LEFT">+ env_tag</TD></TR><TR><TD ALIGN="LEFT">+ grid_size</TD></TR><TR><TD ALIGN="LEFT">+ log_csv_path</TD></TR><TR><TD ALIGN="LEFT">+ min_wet_frames</TD></TR><TR><TD ALIGN="LEFT">+ product</TD></TR><TR><TD ALIGN="LEFT">+ raw_extent</TD></TR><TR><TD ALIGN="LEFT">+ raw_temp_dir</TD></TR><TR><TD ALIGN="LEFT">+ res_deg</TD></TR><TR><TD ALIGN="LEFT">+ res_km</TD></TR><TR><TD ALIGN="LEFT"><I>+ 13 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ __init__(username_pps, password_pps, raw_tem…)</TD></TR><TR><TD ALIGN="LEFT">- _fmt(seconds)</TD></TR><TR><TD ALIGN="LEFT">+ rainfall_to_dbz(rain_rate)</TD></TR><TR><TD ALIGN="LEFT">- _config(stride)</TD></TR><TR><TD ALIGN="LEFT">- _ensure_gpm_configured()</TD></TR><TR><TD ALIGN="LEFT">- _interpolate_to_high_res_grid(ds)</TD></TR><TR><TD ALIGN="LEFT">- _extract_valid_sequences(da_rain, stride)</TD></TR><TR><TD ALIGN="LEFT">- _cache_path(year, month)</TD></TR><TR><TD ALIGN="LEFT">- _check_cache(npz_path, stride)</TD></TR><TR><TD ALIGN="LEFT">- _sanitize_master_log()</TD></TR><TR><TD ALIGN="LEFT">- _upsert_master(rec)</TD></TR><TR><TD ALIGN="LEFT">- _append_session(rec)</TD></TR><TR><TD ALIGN="LEFT">- _record(**kw)</TD></TR><TR><TD ALIGN="LEFT">+ fetch_and_process_month(year, month, stride, force_reproces…)</TD></TR><TR><TD ALIGN="LEFT"><I>+ 1 mais</I></TD></TR></TABLE></TD></TR></TABLE>>];
  celula -> cls_IMERGExtractorAdaptee [arrowtail=diamond, dir=back, label="define"];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>calendar<BR/>datetime<BR/>gpm<BR/>json<BR/>numpy<BR/>os<BR/>pandas<BR/>shutil<BR/>time<BR/>typing<BR/>uuid<BR/>xarray>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>ENV_TAG>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
  arquivos [shape=folder, style=filled, fillcolor="#EDE7F6", fontsize=9, label=<<B>arquivos citados</B><BR/>.tmp.npz<BR/>_2019_2025.csv<BR/>_antes_etl_v2.csv<BR/>log_tempos_etl_imerg_2019_2025.csv<BR/>log_tempos_etl_imerg_2020_2026.csv>];
  celula -> arquivos [style=dotted, arrowhead=open, label="lê/grava"];
}
