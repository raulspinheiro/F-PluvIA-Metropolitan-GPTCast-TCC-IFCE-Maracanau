digraph "4" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 4</B> — 401 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 4</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ ACCUM_STEPS_AUTO</TD></TR><TR><TD ALIGN="LEFT">+ ACELERACAO_CUDA</TD></TR><TR><TD ALIGN="LEFT">+ BATCH_SIZE_AUTO</TD></TR><TR><TD ALIGN="LEFT">+ CASE_STUDY_ISO</TD></TR><TR><TD ALIGN="LEFT">+ CONTEXT_STEPS</TD></TR><TR><TD ALIGN="LEFT">+ FORCE_RETRAIN</TD></TR><TR><TD ALIGN="LEFT">+ FORECAST_STEPS</TD></TR><TR><TD ALIGN="LEFT">+ GRID_SIZE</TD></TR><TR><TD ALIGN="LEFT">+ N_TIMING_REPEATS</TD></TR><TR><TD ALIGN="LEFT">+ NUM_WORKERS_AUTO</TD></TR><TR><TD ALIGN="LEFT">+ RES_KM</TD></TR><TR><TD ALIGN="LEFT">+ SEED</TD></TR><TR><TD ALIGN="LEFT">+ STRIDE_JANELAS</TD></TR><TR><TD ALIGN="LEFT">+ TOKENIZACAO_TREINO</TD></TR><TR><TD ALIGN="LEFT"><I>+ 70 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>copy<BR/>datetime<BR/>glob<BR/>google<BR/>gptcast<BR/>json<BR/>lightning<BR/>numpy<BR/>os<BR/>pandas<BR/>pytorch_lightning<BR/>re<BR/>shutil<BR/>time<BR/><I>+ 1 mais</I>>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>CHECKPOINTS_DIR<BR/>CHECKPOINTS_ENV_DIR<BR/>ENV_LABEL<BR/>ENV_TAG<BR/>GPM_RAW_TEMP_DIR<BR/>IMERGExtractorAdaptee<BR/>IMERGToMiaradAdapter<BR/>RESULTS_ENV_DIR<BR/>SERIES_CACHE_DIR<BR/>gpt8_zeroshot>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
  arquivos [shape=folder, style=filled, fillcolor="#EDE7F6", fontsize=9, label=<<B>arquivos citados</B><BR/>_2019_2025.json<BR/>gptcast8_rmf_2km*.ckpt<BR/>gptcast8_rmf_2km*best*.ckpt<BR/>metrics.csv>];
  celula -> arquivos [style=dotted, arrowhead=open, label="lê/grava"];
}
