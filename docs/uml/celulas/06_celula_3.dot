  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 3</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ SPLIT_YEARS</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  cls_GPTCastDataTarget [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2FD"><TR><TD><FONT POINT-SIZE="9">«classe»</FONT><BR/><B>GPTCastDataTarget</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ setup(stage)</TD></TR><TR><TD ALIGN="LEFT">+ train_dataloader()</TD></TR><TR><TD ALIGN="LEFT">+ val_dataloader()</TD></TR><TR><TD ALIGN="LEFT">+ test_dataloader()</TD></TR><TR><TD ALIGN="LEFT">+ get_forecast_input(batch)</TD></TR></TABLE></TD></TR></TABLE>>];
