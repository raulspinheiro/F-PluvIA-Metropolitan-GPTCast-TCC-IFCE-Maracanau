  cls_IMERGToMiaradAdapter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2FD"><TR><TD><FONT POINT-SIZE="9">«classe»</FONT><BR/><B>IMERGToMiaradAdapter</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ adaptee</TD></TR><TR><TD ALIGN="LEFT">+ all_sequences_dbz</TD></TR><TR><TD ALIGN="LEFT">+ all_timestamps</TD></TR><TR><TD ALIGN="LEFT">+ allow_proportional_fallback</TD></TR><TR><TD ALIGN="LEFT">+ batch_size</TD></TR><TR><TD ALIGN="LEFT">+ cache_dir</TD></TR><TR><TD ALIGN="LEFT">+ center_lat</TD></TR><TR><TD ALIGN="LEFT">+ center_lon</TD></TR><TR><TD ALIGN="LEFT">+ env_label</TD></TR><TR><TD ALIGN="LEFT">+ env_tag</TD></TR><TR><TD ALIGN="LEFT">+ file_report</TD></TR><TR><TD ALIGN="LEFT">+ grid_size</TD></TR><TR><TD ALIGN="LEFT">+ num_workers</TD></TR><TR><TD ALIGN="LEFT">+ res_deg</TD></TR><TR><TD ALIGN="LEFT"><I>+ 12 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ __init__(adaptee, cache_dir, seq_len, train_…)</TD></TR><TR><TD ALIGN="LEFT">- _list_files()</TD></TR><TR><TD ALIGN="LEFT">+ setup(stage)</TD></TR><TR><TD ALIGN="LEFT">+ create_gptcast_splits(val_ratio, test_ratio)</TD></TR><TR><TD ALIGN="LEFT">- _summarize(mode, bounds)</TD></TR><TR><TD ALIGN="LEFT">- _loader(split, shuffle)</TD></TR><TR><TD ALIGN="LEFT">- _loaders()</TD></TR><TR><TD ALIGN="LEFT">+ train_dataloader()</TD></TR><TR><TD ALIGN="LEFT">+ val_dataloader()</TD></TR><TR><TD ALIGN="LEFT">+ test_dataloader()</TD></TR><TR><TD ALIGN="LEFT">+ get_forecast_input(batch)</TD></TR><TR><TD ALIGN="LEFT">+ partition_of(ts)</TD></TR><TR><TD ALIGN="LEFT">+ get_sequence_by_datetime(target_iso_str, tolerance_min)</TD></TR></TABLE></TD></TR></TABLE>>];
  celula -> cls_IMERGToMiaradAdapter [arrowtail=diamond, dir=back, label="define"];
