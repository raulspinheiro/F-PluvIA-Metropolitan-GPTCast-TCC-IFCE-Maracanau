digraph "extra_1" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula Extra 1</B> — 268 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula Extra 1</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ BUILTINS</TD></TR><TR><TD ALIGN="LEFT">+ COR_FUNDO</TD></TR><TR><TD ALIGN="LEFT">+ COR_TEXTO</TD></TR><TR><TD ALIGN="LEFT">+ CSS</TD></TR><TR><TD ALIGN="LEFT">+ GPTCAST</TD></TR><TR><TD ALIGN="LEFT">+ KW_DECL</TD></TR><TR><TD ALIGN="LEFT">+ KW_FLUXO</TD></TR><TR><TD ALIGN="LEFT">+ MOSTRAR_CODIGO</TD></TR><TR><TD ALIGN="LEFT">+ NOTEBOOK_PATH</TD></TR><TR><TD ALIGN="LEFT">+ alt</TD></TR><TR><TD ALIGN="LEFT">+ aviso</TD></TR><TR><TD ALIGN="LEFT">+ badges</TD></TR><TR><TD ALIGN="LEFT">+ blocos</TD></TR><TR><TD ALIGN="LEFT">+ cels</TD></TR><TR><TD ALIGN="LEFT"><I>+ 12 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ nomes_do_pacote(pacote)</TD></TR><TR><TD ALIGN="LEFT">- _rotulo(src, padrao)</TD></TR><TR><TD ALIGN="LEFT">+ celulas()</TD></TR><TR><TD ALIGN="LEFT">+ ocultar(src)</TD></TR><TR><TD ALIGN="LEFT">+ importados_do_gptcast(src)</TD></TR><TR><TD ALIGN="LEFT">+ destacar(src, nomes_sessao)</TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>IPython<BR/>ast<BR/>builtins<BR/>html<BR/>importlib<BR/>io<BR/>json<BR/>os<BR/>pandas<BR/>pathlib<BR/>re<BR/>time<BR/>token<BR/>tokenize>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>ENV_TAG<BR/>RESULTS_ENV_DIR<BR/>SERIES_CACHE_DIR>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
}
