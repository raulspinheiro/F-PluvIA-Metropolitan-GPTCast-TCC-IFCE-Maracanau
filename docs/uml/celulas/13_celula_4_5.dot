  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>contextlib<BR/>einops<BR/>glob<BR/>gptcast<BR/>hashlib<BR/>io<BR/>json<BR/>math<BR/>matplotlib<BR/>numpy<BR/>os<BR/>pandas<BR/>textwrap<BR/>time<BR/><I>+ 2 mais</I>>];
