digraph "deploy_automatizado" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula (Deploy Automatizado)</B> — 312 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula (Deploy Automatizado)</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ BASE_DIR</TD></TR><TR><TD ALIGN="LEFT">+ CLONE_DIR</TD></TR><TR><TD ALIGN="LEFT">+ CRIAR_README_SE_FALTAR</TD></TR><TR><TD ALIGN="LEFT">+ EXPORTAR_CELULAS</TD></TR><TR><TD ALIGN="LEFT">+ EXT_RESULTADOS</TD></TR><TR><TD ALIGN="LEFT">+ GIT_USER_EMAIL</TD></TR><TR><TD ALIGN="LEFT">+ GIT_USER_NAME</TD></TR><TR><TD ALIGN="LEFT">+ GITHUB_TOKEN</TD></TR><TR><TD ALIGN="LEFT">+ GITHUB_USER</TD></TR><TR><TD ALIGN="LEFT">+ IGNORAR_RESULTADOS</TD></TR><TR><TD ALIGN="LEFT">+ MAX_MB</TD></TR><TR><TD ALIGN="LEFT">+ NOTEBOOK_NAME</TD></TR><TR><TD ALIGN="LEFT">+ NOTEBOOK_PATH</TD></TR><TR><TD ALIGN="LEFT">+ RAMO</TD></TR><TR><TD ALIGN="LEFT"><I>+ 29 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ git(*args, cwd, auth)</TD></TR><TR><TD ALIGN="LEFT">+ copiar(src, dst_rel)</TD></TR><TR><TD ALIGN="LEFT">+ espelhar(pasta_rel, manter, padroes)</TD></TR><TR><TD ALIGN="LEFT">+ ocultar(s)</TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>base64<BR/>datetime<BR/>fnmatch<BR/>google<BR/>hashlib<BR/>json<BR/>os<BR/>pathlib<BR/>re<BR/>shutil<BR/>subprocess<BR/>unicodedata>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>BASE_DIR<BR/>DETECTED_NB_PATH<BR/>ENV_TAG<BR/>LAST_JSON_CERT<BR/>PSEUDO_DIR<BR/>REPO_URL<BR/>RESULTS_ENV_DIR<BR/>SERIES_CACHE_DIR<BR/>UML_DIR>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
  arquivos [shape=folder, style=filled, fillcolor="#EDE7F6", fontsize=9, label=<<B>arquivos citados</B><BR/>README.md>];
  celula -> arquivos [style=dotted, arrowhead=open, label="lê/grava"];
}
