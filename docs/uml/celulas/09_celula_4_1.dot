  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 4.1</B> — 241 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 4.1</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ BATCH_INF</TD></TR><TR><TD ALIGN="LEFT">+ CELL4_1_VALIDACAO</TD></TR><TR><TD ALIGN="LEFT">+ CONTEXT</TD></TR><TR><TD ALIGN="LEFT">+ D</TD></TR><TR><TD ALIGN="LEFT">+ L</TD></TR><TR><TD ALIGN="LEFT">+ N</TD></TR><TR><TD ALIGN="LEFT">+ N_BOOT</TD></TR><TR><TD ALIGN="LEFT">+ RESULTS_ENV_DIR</TD></TR><TR><TD ALIGN="LEFT">+ SEED</TD></TR><TR><TD ALIGN="LEFT">+ TOKENS_QUADRO</TD></TR><TR><TD ALIGN="LEFT">+ TOL_REGISTRO</TD></TR><TR><TD ALIGN="LEFT">+ USA_CUDA</TD></TR><TR><TD ALIGN="LEFT">+ am</TD></TR><TR><TD ALIGN="LEFT">+ ax1</TD></TR><TR><TD ALIGN="LEFT"><I>+ 51 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ perdas_por_janela(model)</TD></TR><TR><TD ALIGN="LEFT">- _sync()</TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>json<BR/>matplotlib<BR/>numpy<BR/>os<BR/>pandas<BR/>textwrap<BR/>time<BR/>torch>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>CONTEXT_STEPS<BR/>ENV_LABEL<BR/>ENV_TAG<BR/>RESULTS_ENV_DIR<BR/>SEED<BR/>SERIES_CACHE_DIR<BR/>VAL_CROP<BR/>best_ckpt_path<BR/>md_rmf<BR/>training_record_json>];
