digraph "12" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 12</B> — 464 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 12</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ A_DIR</TD></TR><TR><TD ALIGN="LEFT">+ AMOSTRAGEM</TD></TR><TR><TD ALIGN="LEFT">+ AMOSTRAGEM_TXT</TD></TR><TR><TD ALIGN="LEFT">+ AMOSTRAGENS</TD></TR><TR><TD ALIGN="LEFT">+ BASE_DIR</TD></TR><TR><TD ALIGN="LEFT">+ CELL12_FULL_2025_RESULTS</TD></TR><TR><TD ALIGN="LEFT">+ CFG</TD></TR><TR><TD ALIGN="LEFT">+ CHUNK</TD></TR><TR><TD ALIGN="LEFT">+ CKPT_DIR</TD></TR><TR><TD ALIGN="LEFT">+ DESC</TD></TR><TR><TD ALIGN="LEFT">+ DEVICE</TD></TR><TR><TD ALIGN="LEFT">+ GPU_NOME</TD></TR><TR><TD ALIGN="LEFT">+ INCLUIR_MEDIA</TD></TR><TR><TD ALIGN="LEFT">+ KEYS</TD></TR><TR><TD ALIGN="LEFT"><I>+ 83 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- _digest(model)</TD></TR><TR><TD ALIGN="LEFT">- _silencio()</TD></TR><TR><TD ALIGN="LEFT">- _sync()</TD></TR><TR><TD ALIGN="LEFT">- _rain(dbz)</TD></TR><TR><TD ALIGN="LEFT">- _lote(model, n)</TD></TR><TR><TD ALIGN="LEFT">- _gptcast(model, ctx_dbz, seed, cfg)</TD></TR><TR><TD ALIGN="LEFT">- _dbz(r)</TD></TR><TR><TD ALIGN="LEFT">- _cont(o, p, thr)</TD></TR><TR><TD ALIGN="LEFT">- _scores(tp, fp, fn, tn)</TD></TR><TR><TD ALIGN="LEFT">+ metrics_block(o, p, name, lead_label, ssim_vals)</TD></TR><TR><TD ALIGN="LEFT">- _save(df, nome)</TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>contextlib<BR/>datetime<BR/>einops<BR/>glob<BR/>gptcast<BR/>hashlib<BR/>io<BR/>json<BR/>math<BR/>numpy<BR/>os<BR/>pandas<BR/>skimage<BR/>time<BR/><I>+ 2 mais</I>>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>CONTEXT_STEPS<BR/>ENV_LABEL<BR/>ENV_TAG<BR/>FORECAST_STEPS<BR/>GRID_SIZE<BR/>PyStepsNowcastAdapter<BR/>RESULTS_ENV_DIR<BR/>SERIES_CACHE_DIR<BR/>best_ckpt_path<BR/>fss_over_set<BR/>md_rmf<BR/>sal_over_set<BR/>timing_gpu_log>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
  arquivos [shape=folder, style=filled, fillcolor="#EDE7F6", fontsize=9, label=<<B>arquivos citados</B><BR/>.tmp.npz<BR/>_INVALIDO_versao_emulada.npz<BR/>bloco_*.npz<BR/>cache_cell12_full_1729_test2025_*.npz<BR/>config.json>];
  celula -> arquivos [style=dotted, arrowhead=open, label="lê/grava"];
}
