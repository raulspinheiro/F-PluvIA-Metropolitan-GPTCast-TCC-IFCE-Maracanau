digraph "backup" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula Backup</B> — 189 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula Backup</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ BAIXAR_NO_NAVEGADOR</TD></TR><TR><TD ALIGN="LEFT">+ DESTINO</TD></TR><TR><TD ALIGN="LEFT">+ EXT</TD></TR><TR><TD ALIGN="LEFT">+ IGNORAR</TD></TR><TR><TD ALIGN="LEFT">+ LIMITE_DOWNLOAD_MB</TD></TR><TR><TD ALIGN="LEFT">+ NOTEBOOK_NAME</TD></TR><TR><TD ALIGN="LEFT">+ NOTEBOOK_PATH</TD></TR><TR><TD ALIGN="LEFT">+ PASTAS_EXTRAS</TD></TR><TR><TD ALIGN="LEFT">+ RESULTS_ENV_DIR</TD></TR><TR><TD ALIGN="LEFT">+ STAGE</TD></TR><TR><TD ALIGN="LEFT">+ UML_DIR</TD></TR><TR><TD ALIGN="LEFT">+ agora</TD></TR><TR><TD ALIGN="LEFT">+ amb</TD></TR><TR><TD ALIGN="LEFT">+ avisos</TD></TR><TR><TD ALIGN="LEFT"><I>+ 21 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ copiar_arvore(origem, prefixo)</TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>datetime<BR/>fnmatch<BR/>google<BR/>hashlib<BR/>json<BR/>os<BR/>pathlib<BR/>re<BR/>shutil<BR/>subprocess<BR/>sys<BR/>zipfile>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>DETECTED_NB_PATH<BR/>ENV_LABEL<BR/>ENV_TAG<BR/>RESULTS_ENV_DIR<BR/>SERIES_CACHE_DIR<BR/>UML_DIR>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
  arquivos [shape=folder, style=filled, fillcolor="#EDE7F6", fontsize=9, label=<<B>arquivos citados</B><BR/>LEIA-ME.json<BR/>SHA256SUMS_pacote.txt<BR/>nvidia_smi.txt<BR/>requirements_ambiente_colab.txt>];
  celula -> arquivos [style=dotted, arrowhead=open, label="lê/grava"];
}
