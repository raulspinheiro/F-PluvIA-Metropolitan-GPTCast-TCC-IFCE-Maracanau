digraph "10" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 10</B> — 158 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 10</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ RES_GRID_KM</TD></TR><TR><TD ALIGN="LEFT">+ STEP_MIN</TD></TR><TR><TD ALIGN="LEFT">+ axes</TD></TR><TR><TD ALIGN="LEFT">+ bench_csv_path</TD></TR><TR><TD ALIGN="LEFT">+ bench_fig_path</TD></TR><TR><TD ALIGN="LEFT">+ blocos</TD></TR><TR><TD ALIGN="LEFT">+ color</TD></TR><TR><TD ALIGN="LEFT">+ cols</TD></TR><TR><TD ALIGN="LEFT">+ context_rain_all</TD></TR><TR><TD ALIGN="LEFT">+ d</TD></TR><TR><TD ALIGN="LEFT">+ data_str</TD></TR><TR><TD ALIGN="LEFT">+ df_full_benchmark</TD></TR><TR><TD ALIGN="LEFT">+ df_rank</TD></TR><TR><TD ALIGN="LEFT">+ fig</TD></TR><TR><TD ALIGN="LEFT"><I>+ 20 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  cls_PyStepsNowcastAdapter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2FD"><TR><TD><FONT POINT-SIZE="9">«classe»</FONT><BR/><B>PyStepsNowcastAdapter</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ extrap_fn</TD></TR><TR><TD ALIGN="LEFT">+ linda_fn</TD></TR><TR><TD ALIGN="LEFT">+ linda_status</TD></TR><TR><TD ALIGN="LEFT">+ n_motion</TD></TR><TR><TD ALIGN="LEFT">+ oflow_fn</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ __init__(oflow_method, n_motion)</TD></TR><TR><TD ALIGN="LEFT">+ compute_motion_field(in_dbz_seq)</TD></TR><TR><TD ALIGN="LEFT">+ forecast_extrapolation_lk(last_frame_rain, velocity_field, steps)</TD></TR><TR><TD ALIGN="LEFT">+ forecast_linda(rain_seq_context, velocity_field, s…)</TD></TR></TABLE></TD></TR></TABLE>>];
  celula -> cls_PyStepsNowcastAdapter [arrowtail=diamond, dir=back, label="define"];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>datetime<BR/>gptcast<BR/>matplotlib<BR/>numpy<BR/>os<BR/>pandas<BR/>pysteps<BR/>time>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>ENV_LABEL<BR/>ENV_TAG<BR/>FORECAST_STEPS<BR/>RESULTS_ENV_DIR<BR/>RES_KM<BR/>SERIES_CACHE_DIR<BR/>df_gpt8<BR/>df_gpt8_zs<BR/>df_pers<BR/>dt<BR/>evaluate_nowcast_by_leadtime<BR/>ground_truth_rain<BR/>input_data_dbz<BR/>plot_rmf_spatial<BR/><I>+ 1 mais</I>>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
}
